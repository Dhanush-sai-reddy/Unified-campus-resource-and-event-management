# ===== Campus System (Production Example) =====
# Copy this file to .env on your server and change secrets.

# Public ports exposed on the VM
WEB_PORT=8080
API_PORT=5000
SCHEDULER_PORT=5001
DB_PORT=5436
REDIS_PORT=6379

# Database (Timescale/Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campus_db

# App secrets
JWT_SECRET=please-change-this-to-a-long-random-string

# CORS (set to your deployed domain)
# Example: https://campus.yourdomain.com
CORS_ORIGIN=http://localhost:8080
SOCKET_CORS_ORIGIN=http://localhost:8080

# Prisma safety
# Set to 1 ONLY when you intend to push schema automatically (can be destructive)
PRISMA_DB_PUSH=0

PASSWORD--123456
